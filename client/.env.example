# Copy to client/.env.local. With both Supabase vars set, the client uses Supabase Realtime
# instead of the local ws server.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# VITE_WS_URL=ws://localhost:8080
# Spotify "now playing" (optional; hidden when unset). Client ID of your app on
# developer.spotify.com; redirect URIs: https://<site>/spotify-callback.html and
# http://127.0.0.1:5173/spotify-callback.html (open the dev site on 127.0.0.1, not localhost).
# VITE_SPOTIFY_CLIENT_ID=your-client-id
